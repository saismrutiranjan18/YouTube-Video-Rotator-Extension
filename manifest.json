{
  "manifest_version": 3,
  "name": "YouTube Rotate Pro",
  "version": "1.2.0",
  "description": "Rotate YouTube videos to any angle for comfortable viewing",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "options_page": "options.html"
}